{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.github/revisar-local.js\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/Hub-Spacioam/.github/revisar-local.js\"; command -v node >/dev/null 2>&1 && [ -f \"$f\" ] && exec node \"$f\" --hook; exit 0",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
